# PressFit E2E Test Environment Variables
# Copy this file to .env.e2e (or e2e/.env.e2e) and fill in your test credentials.
# NEVER commit the actual .env.e2e file with real credentials.

E2E_TEST_EMAIL=your-test-email@example.com
E2E_TEST_PASSWORD=your-test-password

# Optional aliases (supported by e2e/run-maestro.js):
# E2E_EMAIL=your-test-email@example.com
# E2E_PASSWORD=your-test-password
# MAESTRO_DEVICE=emulator-5554
